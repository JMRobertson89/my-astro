---
import '../styles/global.css';

const pageTitle = 'About Me';

const identity = {
	firstName: 'Josh',
	country: 'USA',
	occupation: 'Web Developer',
	hobbies: ['crossfit', 'coding', 'running'],
};

const skills = [
	{ name: 'HTML', color: 'red' },
	{ name: 'CSS', color: 'green' },
	{ name: 'JavaScript', color: 'yellowgreen' },
	{ name: 'React', color: 'blue' },
	{ name: 'Astro', color: 'black' },
];

const happy = true;
const finished = false;
const goal = 3;

const skillColor = 'crimson';
const fontWeight = 'bold';
const textCase = 'uppercase';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<style define:vars={{ fontWeight, textCase }}>
			h1 {
				color: purple;
				font-size: 4rem;
			}
			.skill {
				font-weight: var(--fontWeight);
				text-transform: var(--textCase);
			}
		</style>
	</head>
	<body>
		<a href="/">Home</a>
		<a href="/about/">About</a>
		<a href="/blog/">Blog</a>
		<h1>{pageTitle}</h1>
		<h2>... and my new Astro site!</h2>

		<p>
			I am working through Astro's introductory tutorial. This is the second
			page on my website, and it's the first one I built myself!
		</p>

		<p>
			This site will update as I complete more of the tutorial, so keep checking
			back and see how my journey is going!
		</p>

		<p>Here are a few facts about me:</p>
		<ul>
			<li>My name is {identity.firstName}</li>
			<li>
				I live in the {identity.country} and I work as a {identity.occupation}
			</li>
			{
				identity.hobbies.length >= 3 && (
					<li>
						Three of my hobbies are: {identity.hobbies[0]},{' '}
						{identity.hobbies[1]}, {identity.hobbies[2]}
					</li>
				)
			}
		</ul>
		<p>My skills are:</p>
		<ul>
			{
				skills.map((skill) => (
					<li class="skill" style={`color: ${skill.color}`}>
						{skill.name}
					</li>
				))
			}
		</ul>
		{happy && <p>I am happy to be learning Astro!</p>}
		{finished && <p>I Finsidhed this tutorial!</p>}
		{
			goal === 3 ? (
				<p>My goals is to finish in 3 days.</p>
			) : (
				<p>My goal is not 3 days.</p>
			)
		}
	</body>
</html>
